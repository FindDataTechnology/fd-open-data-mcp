# =============================================================================
# Local Environment Variables (DO NOT COMMIT)
# Override any settings from .env here
# =============================================================================

# SEC EDGAR Identity (Required for accessing SEC data)
EDGAR_IDENTITY=finddatatechnology@gmail.com

# API Keys (fill in as needed)
WIND_API_KEY=
IFIND_API_KEY=
TONGDAOXIN_API_KEY=

# Database URL (optional override)
FD_OPEN_DATA_MCP_DATABASE_URL=postgresql://admin:admin123@192.168.1.4:5433/postgres

# =============================================================================
# LLM Configuration - Linjie Provider (DeepSeek)
# =============================================================================
# Using linjie.love as OpenAI-compatible endpoint
LLM_BASE_URL=https://www.linjie.love/v1
LLM_API_KEY=sk-EjZ35p9zLeE9_7Bz7oaw-x1ZFv_opHQHAQGAwgU1izg

# LiteLLM model format: provider/model-name
# For OpenAI-compatible APIs, use "openai/" prefix
LLM_MODEL=openai/deepseek-v4-flash

# PDF Processing Model (specifically for fd-cn-report PDF extraction)
PDF_PROCESS_MODEL=openai/deepseek-v4-flash

# Alternative models:
# LLM_MODEL=openai/gpt-4o
# LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
# LLM_MODEL=ollama/llama3.1

# ── Local Document Save ─────────────────────────────────────────
# Save downloaded PDFs to a user-visible directory (optional).
#CNREPORT_SAVE_DIR=~/Documents/cn-reports

# ── MinIO Document Storage ──────────────────────────────────────
# Upload downloaded PDFs to MinIO for shared archival (optional).
MINIO_UPLOAD_ENABLED=false
MINIO_ENDPOINT=23.144.68.246:30900
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=QXqpAKgT04Ak2MyKWC2L
MINIO_BUCKET=fd-cn-reports
MINIO_SECURE=false
