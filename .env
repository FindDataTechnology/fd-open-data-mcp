# =============================================================================
# fd-open-data-mcp Configuration
# =============================================================================
# Copy this file to .env.local and modify as needed.
# DO NOT commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
FD_OPEN_DATA_MCP_DATABASE_URL=sqlite:///metadata/daas.db

# -----------------------------------------------------------------------------
# FindData Root Directory
# -----------------------------------------------------------------------------
FINDDATA_ROOT=/Users/chengsishi/finddata

# -----------------------------------------------------------------------------
# SEC EDGAR Identity (Required for accessing SEC data)
# Format: email or "Name <email>"
# More info: https://www.sec.gov/os/accessing-edgar-data
# -----------------------------------------------------------------------------
EDGAR_IDENTITY=finddatatechnology@gmail.com

# -----------------------------------------------------------------------------
# API Keys for External Services
# -----------------------------------------------------------------------------

# Wind Financial Terminal (optional - requires license)
WIND_API_KEY=

# iFinD Data Platform (optional)
IFIND_API_KEY=

# Tongdaxin Data (optional)
TONGDAOXIN_API_KEY=

# -----------------------------------------------------------------------------
# Proxy Configuration
# -----------------------------------------------------------------------------
PROXY_ENABLED=false
PROXY_URLS=

# -----------------------------------------------------------------------------
# Rate Limiting Settings
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Cache Settings
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Development Settings (DO NOT use in production)
# -----------------------------------------------------------------------------
DEV_MODE=false

# -----------------------------------------------------------------------------
# LLM Configuration for fd-cn-report (PDF Financial Report Extraction)
# -----------------------------------------------------------------------------
# fd-cn-report uses LLM to extract financial indicators from PDF reports.
# Supports any OpenAI-compatible API (OpenAI, Azure OpenAI, local LLMs, etc.)

# API Base URL (OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.openai.com/v1

# API Key (supports both LLM_API_KEY and OPENAI_API_KEY)
# Priority: LLM_API_KEY > OPENAI_API_KEY
LLM_API_KEY=

# Model name (default: gpt-4o)
LLM_MODEL=gpt-4o

# Alternative: Use OPENAI_API_KEY instead (for backward compatibility)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Examples for different providers:
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
# Azure:      LLM_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Playwright Configuration (Web Scraping)
# -----------------------------------------------------------------------------
# Playwright is used for scraping websites that require JavaScript rendering.
# Install browsers: playwright install chromium

# Browser type: chromium, firefox, webkit (default: chromium)
PLAYWRIGHT_BROWSER=chromium

# Headless mode: true for background operation, false to see browser
PLAYWRIGHT_HEADLESS=true

# Browser timeout in milliseconds (default: 30000 = 30 seconds)
PLAYWRIGHT_TIMEOUT=30000

# Slow down operations by this many milliseconds (useful for debugging)
PLAYWRIGHT_SLOW_MO=0

# User agent string (leave empty for default)
PLAYWRIGHT_USER_AGENT=

# Proxy configuration for Playwright (optional)
PLAYWRIGHT_PROXY_SERVER=
PLAYWRIGHT_PROXY_USERNAME=
PLAYWRIGHT_PROXY_PASSWORD=

# Viewport size
PLAYWRIGHT_VIEWPORT_WIDTH=1920
PLAYWRIGHT_VIEWPORT_HEIGHT=1080

# Enable/disable JavaScript (default: true)
PLAYWRIGHT_JAVASCRIPT_ENABLED=true

# Ignore HTTPS errors (default: false, use with caution)
PLAYWRIGHT_IGNORE_HTTPS_ERRORS=false
