# fd-open-data-mcp torch image — slim variant + sentence-transformers with the
# embedding model baked in. The k8s deployment sets HF_HUB_OFFLINE=1, so the
# model must be downloaded at build time, as the runtime user (uid 1000) so
# the default HF cache path resolves at runtime.
# Built by .github/workflows/docker-publish.yml (torch job) ->
# <HARBOR_HOST>/finddata/fd-open-data-mcp:torch
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10
# Upstream sources by default (GitHub-hosted runners); CN build boxes pass
#   --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   --build-arg PIP_EXTRA_INDEX=https://mirrors.aliyun.com/pypi/simple/
#   --build-arg HF_ENDPOINT=https://hf-mirror.com
ARG PIP_INDEX_URL=""
ARG PIP_EXTRA_INDEX=""
ARG HF_ENDPOINT=

WORKDIR /build
COPY . .

# CPU-only torch wheel ferried into the build context (download.pytorch.org
# is unreachable at usable speed from domestic networks); remaining deps via
# the Aliyun PyPI mirror.
RUN PIP_FLAGS=""; [ -n "$PIP_INDEX_URL" ] && PIP_FLAGS="-i $PIP_INDEX_URL"; \
    EXTRA_FLAGS=""; [ -n "$PIP_EXTRA_INDEX" ] && EXTRA_FLAGS="--extra-index-url $PIP_EXTRA_INDEX"; \
    pip install --no-cache-dir $PIP_FLAGS $EXTRA_FLAGS wheels/torch-*.whl && \
    pip install --no-cache-dir $PIP_FLAGS $EXTRA_FLAGS . sentence-transformers

RUN useradd --create-home --uid 1000 appuser
USER appuser

# CN-side builds export HF_ENDPOINT=https://hf-mirror.com (see ARG above);
# hosted runners reach huggingface.co directly.
RUN if [ -n "$HF_ENDPOINT" ]; then export HF_ENDPOINT="$HF_ENDPOINT"; fi; \
    python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

ENV HF_HOME=/home/appuser/.cache/huggingface

# Alembic migration chain, not part of the site-packages install; same
# rationale as the plain Dockerfile — the deploy-time migration stage
# (python -m fd_open_data_mcp.db.migrate_stage) resolves /app/alembic via
# its cwd fallback (WORKDIR /app), override with FD_OPEN_DATA_MCP_ALEMBIC_DIR.
# Last so chain edits don't invalidate the heavy model-download layer.
WORKDIR /app
COPY alembic/ /app/alembic/
COPY alembic.ini /app/alembic.ini

EXPOSE 8899
ENTRYPOINT ["fd-open-data-mcp", "serve", "--transport", "http", "--host", "0.0.0.0", "--port", "8899"]
