# =============================================================================
# fd-open-data-mcp Configuration
# =============================================================================
# Copy this file to .env.local and modify as needed.
# DO NOT commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
FD_OPEN_DATA_MCP_DATABASE_URL=sqlite:///metadata/daas.db

# -----------------------------------------------------------------------------
# Graph Search Configuration
# -----------------------------------------------------------------------------
# Cache TTL for entity graph (in seconds, default: 300 = 5 minutes)
GRAPH_CACHE_TTL=300

# -----------------------------------------------------------------------------
# Semantic Search Configuration
# -----------------------------------------------------------------------------
# Embedding model name (default: all-MiniLM-L6-v2); resolved by name, never a
# machine-specific cache path
FD_MCP_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cache size for embeddings (max number of query embeddings cached in memory)
EMBEDDING_CACHE_SIZE=1000

# Vector similarity backend: json (default; legacy full scan over the JSON
# columns, runs on SQLite too) | matrix (transitional in-process numpy matrix
# cache) | pgvector (indexed vector(384) columns, PostgreSQL only)
FD_MCP_VECTOR_BACKEND=json

# Seconds the matrix backend keeps its loaded embedding matrix before
# reloading (write tools invalidate immediately)
VECTOR_MATRIX_TTL=300

# -----------------------------------------------------------------------------
# FindData Root Directory
# -----------------------------------------------------------------------------
FINDDATA_ROOT=/Users/chengsishi/finddata

# -----------------------------------------------------------------------------
# SEC EDGAR Identity (Required for accessing SEC data)
# Format: email or "Name <email>"
# More info: https://www.sec.gov/os/accessing-edgar-data
# -----------------------------------------------------------------------------
EDGAR_IDENTITY=finddatatechnology@gmail.com

# -----------------------------------------------------------------------------
# API Keys for External Services
# -----------------------------------------------------------------------------

# Wind Financial Terminal (optional - requires license)
WIND_API_KEY=

# iFinD Data Platform (optional)
IFIND_API_KEY=

# Tongdaxin Data (optional)
TONGDAOXIN_API_KEY=

# -----------------------------------------------------------------------------
# Proxy Configuration
# -----------------------------------------------------------------------------
PROXY_ENABLED=false
PROXY_URLS=

# -----------------------------------------------------------------------------
# Rate Limiting Settings
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Search Result Cache
# -----------------------------------------------------------------------------
# TTL cache for search tool results (semantic_search / ai_search / graph_search
# ...). Cached hits are marked "cached": true in tool output. Write tools
# (update_entity / add_relationship / ...) invalidate immediately.
CACHE_ENABLED=true
SEARCH_RESULT_CACHE_TTL=300

# -----------------------------------------------------------------------------
# Development Settings (DO NOT use in production)
# -----------------------------------------------------------------------------
DEV_MODE=false
